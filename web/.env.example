# Hosted PostgreSQL (Neon via Vercel Marketplace, or Supabase) - RECOMMENDED FOR VERCEL
DATABASE_URL=postgresql://user:password@ep-example-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require

# Or fallback to local Docker PostgreSQL (docker compose up -d at repo root)
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=ecommerce_growth
POSTGRES_USER=analyst
POSTGRES_PASSWORD=analyst_dev_pass

PG_POOL_MAX=5
PG_STATEMENT_TIMEOUT_MS=25000

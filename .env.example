# =============================================================================
# ENVIRONMENT CONFIGURATION — E-COMMERCE GROWTH INTELLIGENCE
# =============================================================================

# Option 1: Hosted PostgreSQL (Neon via Vercel Marketplace, or Supabase) - RECOMMENDED FOR VERCEL
# This is automatically set by Vercel when connecting a Neon database integration.
DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@ep-sample-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require

# Option 2: Local Docker Container (docker-compose up -d on Port 5433)
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=ecommerce_growth
POSTGRES_USER=analyst
POSTGRES_PASSWORD=analyst_dev_pass

# Seed Configuration
RANDOM_SEED=42

# Optional Pool Tuning (Defaults: max=5, statement_timeout=25000ms)
PG_POOL_MAX=5
PG_STATEMENT_TIMEOUT_MS=25000
